#!/usr/bin/env bash
set -e

# Очистка старых транзитных правил
iptables -t mangle -F
iptables -t nat -F PREROUTING
iptables -t nat -F POSTROUTING
iptables -F FORWARD

# 1. TCP MSS Clamping (Фикс MTU для веб-серфинга)
iptables -t mangle -A PREROUTING -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss ${tcp_mss_clamp}

# 2. DNAT (L3 Проброс Port Hopping на Dataforest)
iptables -t nat -A PREROUTING -p udp --dport ${port_hopping_range} -j DNAT --to-destination ${dataforest_ip}

# 3. SNAT / MASQUERADE (Симметричный роутинг)
iptables -t nat -A POSTROUTING -d ${dataforest_ip} -p udp --dport ${port_hopping_range} -j MASQUERADE

# 4. Защита от UDP-флуда и сканеров портов
iptables -A FORWARD -p udp --dport ${port_hopping_range} -m state --state NEW \
    -m hashlimit --hashlimit-upto 20/sec --hashlimit-burst 100 --hashlimit-mode srcip \
    --hashlimit-name udp_flood -j ACCEPT

iptables -A FORWARD -p udp --dport ${port_hopping_range} -m state --state NEW -j DROP
iptables -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT
